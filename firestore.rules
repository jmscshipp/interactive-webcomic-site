rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /comments/{commentId} {
      allow read: if true;
      allow create: if
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() > 0 &&
        request.resource.data.authorName.size() < 50 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() < 1000 &&
        request.resource.data.pageIndex is int;
      allow update, delete: if false;
    }

    match /pageVotes/{page} {
      // the doc holding votingEndTime: readable by everyone, writable only via console/Admin SDK
      allow read: if true;
      allow write: if false;

      function votingOpen() {
        let path = /databases/$(database)/documents/pageVotes/$(page);
        return exists(path)
          && request.time < get(path).data.votingEndTime;
      }

      match /options/{opt} {
        allow read: if true;

        // first vote for an option creates the doc
        allow create: if votingOpen()
          && opt.matches('[0-9]{1,2}')
          && request.resource.data.keys().hasOnly(['votes'])
          && request.resource.data.votes == 1;

        // later votes increment it by exactly 1
        allow update: if votingOpen()
          && request.resource.data.keys().hasOnly(['votes'])
          && request.resource.data.votes == resource.data.votes + 1;

        allow delete: if false;
      }
    }
  }
}